{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {"GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"}
    },
    "orderly-docs": {
      "command": "node",
      "args": ["tools/docs-mcp/server.js"],
      "env": {"DOCS_API_KEY": "${DOCS_API_KEY}"}
    }
  }
}
